# Copy to .env and adjust. Every variable is optional.

# ── HTTP ──────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
# Canonical origin used in share links and QR codes (no trailing slash).
# Leave empty to use whatever origin the page was loaded from.
PUBLIC_URL=
# Honour X-Forwarded-For for rate limiting. Only enable behind a trusted proxy.
TRUST_PROXY=false
# Comma-separated Origins allowed to open the signaling WebSocket (empty = any).
ALLOWED_ORIGINS=
# Directory with the built client. Set to empty to run signaling only.
# STATIC_DIR=/app/client/dist

# ── Share codes ───────────────────────────────────────────────────────────
# 5 or 6 characters from 23456789abcdefghjkmnpqrstuvwxyz.
CODE_LENGTH=5
# A code expires after this long without signaling activity (default 24 h).
ROOM_IDLE_TTL_SECONDS=86400
# How long a code survives the sender's socket dropping without a clean close.
HOST_GRACE_SECONDS=20
MAX_PEERS_PER_ROOM=32

# ── ICE (WebRTC connectivity) ─────────────────────────────────────────────
STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
# TURN is needed when both peers sit behind symmetric NATs / strict firewalls.
TURN_URLS=
# Either static credentials…
TURN_USERNAME=
TURN_CREDENTIAL=
# …or coturn's REST API shared secret (preferred: short-lived credentials).
TURN_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=86400

# ── docker-compose coturn profile only ────────────────────────────────────
TURN_EXTERNAL_IP=
TURN_REALM=pizzadrop
