# `vite build --mode static` (npm run build:static): a build that needs no
# backend of its own, for GitHub Pages, Cloudflare Pages or any static host.
# Signaling goes through public relays (a PeerJS server and several Nostr
# relays, used all at once); override any of these with real environment
# variables at build time (see README → Static hosting).
VITE_SIGNALING=relays
# VITE_PEERJS_URL=wss://0.peerjs.com/peerjs          (none = don't use PeerJS)
# VITE_PEERJS_KEY=peerjs
# VITE_NOSTR_RELAYS=wss://nos.lol,wss://relay.damus.io  (none = don't use Nostr)
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# VITE_ICE_SERVERS_URL=https://<app>.metered.live/api/v1/turn/credentials?apiKey=<key>
# VITE_PUBLIC_URL=https://drop.example.com
