{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@pizzadrop/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["src/workers", "src/sw", "src/**/*.test.ts"]
}
