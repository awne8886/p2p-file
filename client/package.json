{
  "name": "@pizzadrop/client",
  "version": "1.0.0",
  "private": true,
  "description": "PizzaDrop web app (Vite + React).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "preview": "vite preview",
    "build:static": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build --mode static"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "client-zip": "^2.5.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@pizzadrop/shared": "1.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.1"
  }
}
